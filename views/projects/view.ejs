<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project.projectName %> - Project Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/projects">Project Manager</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% if (user) { %>
            <li class="nav-item">
              <span class="navbar-text me-3">
                <strong><%= user.fullName %></strong>
              </span>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/projects">Projects</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <div class="row">
      <div class="col-md-8">
        <div class="card shadow-lg">
          <div class="card-body p-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
              <div>
                <h2><%= project.projectName %></h2>
                <small class="text-muted">Created: <%= new Date(project.createdAt).toLocaleDateString() %></small>
              </div>
              <span class="badge bg-<%= 
                project.status === 'Planning' ? 'warning' : 
                project.status === 'In Progress' ? 'info' : 
                'success' 
              %>" style="font-size: 1rem; padding: 0.5rem 1rem;">
                <%= project.status %>
              </span>
            </div>

            <hr>

            <div class="row mb-4">
              <div class="col-md-6">
                <h5 class="text-muted">Description</h5>
                <p><%= project.description %></p>
              </div>
              <div class="col-md-6">
                <h5 class="text-muted">Deadline</h5>
                <p>
                  <strong><%= new Date(project.deadline).toLocaleDateString() %></strong>
                  <% const deadline = new Date(project.deadline);
                     const today = new Date();
                     if (deadline < today) { %>
                    <span class="badge bg-danger">Overdue</span>
                  <% } %>
                </p>
              </div>
            </div>

            <div class="mb-4">
              <h5 class="text-muted">Team Members</h5>
              <% if (project.teamMembers.length > 0) { %>
                <div class="d-flex flex-wrap gap-2">
                  <% project.teamMembers.forEach(member => { %>
                    <span class="badge bg-secondary"><%= member %></span>
                  <% }); %>
                </div>
              <% } else { %>
                <em class="text-muted">No team members assigned</em>
              <% } %>
            </div>

            <div class="d-flex gap-2">
              <a href="/projects/<%= project.id %>/edit" class="btn btn-warning">Edit Project</a>
              <button onclick="deleteProject('<%= project.id %>')" class="btn btn-danger">Delete Project</button>
              <a href="/projects" class="btn btn-secondary">Back to Projects</a>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-lg">
          <div class="card-body p-4">
            <h5>Project Details</h5>
            <hr>
            <div class="mb-3">
              <small class="text-muted">Last Updated</small>
              <p><%= new Date(project.updatedAt).toLocaleDateString() %></p>
            </div>
            <div class="mb-3">
              <small class="text-muted">Project ID</small>
              <p><code><%= project.id %></code></p>
            </div>
            <div>
              <small class="text-muted">Status</small>
              <p>
                <span class="badge bg-<%= 
                  project.status === 'Planning' ? 'warning' : 
                  project.status === 'In Progress' ? 'info' : 
                  'success' 
                %>">
                  <%= project.status %>
                </span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function deleteProject(id) {
      if (confirm('Are you sure you want to delete this project? This action cannot be undone.')) {
        fetch(`/projects/${id}`, {
          method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            window.location.href = '/projects';
          } else {
            alert(data.message || 'Error deleting project');
          }
        })
        .catch(error => console.error('Error:', error));
      }
    }
  </script>
</body>
</html>
