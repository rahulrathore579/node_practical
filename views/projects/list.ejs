<h2>Projects <a href="/project/new">+ New</a></h2>

<% if (projects.length === 0) { %>
  <p>No projects. <a href="/project/new">Create one</a></p>
<% } else { %>
  <table border="1">
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Deadline</th>
      <th>Status</th>
      <th>Team</th>
      <th>Actions</th>
    </tr>
    <% projects.forEach(project => { %>
      <tr>
        <td><%= project.projectName %></td>
        <td><%= project.description.substring(0, 50) %></td>
        <td><%= new Date(project.deadline).toLocaleDateString() %></td>
        <td><%= project.status %></td>
        <td>
          <% if (project.teamMembers.length > 0) { %>
            <%= project.teamMembers.join(', ') %>
          <% } else { %>
            None
          <% } %>
        </td>
        <td>
          <a href="/projects/<%= project.id %>">View</a>
          <a href="/projects/<%= project.id %>/edit">Edit</a>
          <a href="#" onclick="deleteProject('<%= project.id %>'); return false;">Delete</a>
        </td>
      </tr>
    <% }); %>
  </table>
<% } %>

<script>
  function deleteProject(id) {
    if (confirm('Delete this project?')) {
      fetch(`/projects/${id}`, {
        method: 'DELETE'
      })
      .then(() => {
        window.location.reload();
      });
    }
  }
</script>
