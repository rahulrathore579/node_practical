<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects - Project Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/projects">Project Manager</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% if (user) { %>
            <li class="nav-item">
              <span class="navbar-text me-3">
                <strong><%= user.fullName %></strong>
              </span>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/projects">Projects</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Projects</h2>
      <a href="/project/new" class="btn btn-primary">+ New Project</a>
    </div>

    <% if (projects.length === 0) { %>
      <div class="alert alert-info" role="alert">
        No projects yet. <a href="/project/new">Create one now</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="table-primary">
            <tr>
              <th>Project Name</th>
              <th>Description</th>
              <th>Deadline</th>
              <th>Status</th>
              <th>Team Members</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% projects.forEach(project => { %>
              <tr>
                <td><strong><%= project.projectName %></strong></td>
                <td><%= project.description.substring(0, 50) %>...</td>
                <td><%= new Date(project.deadline).toLocaleDateString() %></td>
                <td>
                  <span class="badge bg-<%= 
                    project.status === 'Planning' ? 'warning' : 
                    project.status === 'In Progress' ? 'info' : 
                    'success' 
                  %>"><%= project.status %></span>
                </td>
                <td>
                  <% if (project.teamMembers.length > 0) { %>
                    <%= project.teamMembers.join(', ').substring(0, 40) %><% if (project.teamMembers.join(', ').length > 40) { %>...<% } %>
                  <% } else { %>
                    <em>None</em>
                  <% } %>
                </td>
                <td>
                  <a href="/projects/<%= project.id %>" class="btn btn-sm btn-info">View</a>
                  <a href="/projects/<%= project.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                  <button onclick="deleteProject('<%= project.id %>')" class="btn btn-sm btn-danger">Delete</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function deleteProject(id) {
      if (confirm('Are you sure you want to delete this project?')) {
        fetch(`/projects/${id}`, {
          method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Error deleting project');
          }
        })
        .catch(error => console.error('Error:', error));
      }
    }
  </script>
</body>
</html>
